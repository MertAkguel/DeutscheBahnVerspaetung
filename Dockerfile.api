# Image for the prediction API only. Much smaller than the Airflow image: no Airflow,
# no dev packages, just Python, our package and its runtime dependencies.
#
# Build and start with the rest of the stack: make up
# Alone:  docker build -f Dockerfile.api -t db-delay-api:dev .

FROM python:3.12-slim

# libgomp1: LightGBM needs it. curl: for the health check in docker-compose.yaml.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.21 /uv /usr/local/bin/uv

WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

# Same layer trick as in the Airflow Dockerfile: dependencies first (cached), code last
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
COPY config ./config
RUN uv sync --frozen --no-dev

# Never run a web server as root: if someone breaks in, they are only "app"
RUN useradd --create-home --uid 1000 app
USER app

EXPOSE 8000
# 0.0.0.0: listen on all network interfaces, so other containers and your browser can reach it
CMD ["uvicorn", "db_delay_mlops.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
